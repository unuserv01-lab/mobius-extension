{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "MOBIUS — open Side Panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Your browser, with a mind of its own — and it stays yours. On-device-first AI layer across web apps (Firebase AI Logic / Gemini Nano).",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "MOBIUS — Personal AI Operating Layer",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "src/ui/index.html"
  },
  "version": "0.1.0"
}